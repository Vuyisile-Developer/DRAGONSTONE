&lt;!doctype html&gt;
&lt;html lang="en"&gt;
&lt;head&gt;
 &lt;meta charset="utf-8"&gt;
 &lt;meta name="viewport" content="width=device-width,initial-scale=1"&gt;
 &lt;title&gt;DragonStone — Shop&lt;/title&gt;
 &lt;link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"&gt;
 &lt;link rel="stylesheet" href="css/main_style.css"&gt;
&lt;/head&gt;
&lt;body&gt;
&lt;nav class="navbar navbar-expand-lg navbar-light bg-light"&gt;
 &lt;div class="container"&gt;
 &lt;a class="navbar-brand" href="#"&gt;DragonStone
 &lt;button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"&gt;&lt;span class="navbar-toggler-icon"&gt;&lt;/button&gt;
 &lt;div id="nav" class="collapse navbar-collapse"&gt;
 &lt;ul class="navbar-nav ms-auto"&gt;
 &lt;li class="nav-item"&gt;&lt;a class="nav-link" href="#"&gt;Products
 &lt;li class="nav-item"&gt;&lt;a id="cartBtn" class="nav-link" href="#"&gt;Cart (&lt;span id="cart-count"&gt;0)
 
 
&lt;/nav&gt;
&lt;header class="hero text-center py-5"&gt;
 &lt;div class="container"&gt;
 <h1>Eco-friendly home essentials</h1>
 &lt;p class="lead"&gt;Sustainably sourced. Beautifully made.<p></p>
 
&lt;/header&gt;
&lt;main class="container my-4"&gt;
 &lt;div class="row" id="product-list"&gt;
  &lt;!-- Product cards injected by JS --&gt;
 
&lt;/main&gt;
&lt;!-- Product template modal --&gt;
&lt;div class="modal fade" id="productModal" tabindex="-1"&gt;
 &lt;div class="modal-dialog modal-lg"&gt;
 &lt;div class="modal-content"&gt;
 &lt;div class="modal-header"&gt;
 &lt;h5 id="productTitle" class="modal-title"&gt;
 &lt;button class="btn-close" data-bs-dismiss="modal"&gt;&lt;/button&gt;
 
 &lt;div class="modal-body"&gt;
 &lt;div class="row"&gt;
 &lt;div class="col-md-6"&gt;&lt;img id="productImage" class="img-fluid" alt=""&gt;
 &lt;div class="col-md-6"&gt;
 &lt;p id="productDesc"&gt;<p></p>
 <p><strong>Price: </strong>R &lt;span id="productPrice"&gt;</p>
 <p><strong>Carbon footprint:</strong> &lt;span id="productCarbon"&gt; kg CO₂</p>
 &lt;button id="addToCartBtn" class="btn btn-success"&gt;Add to Cart&lt;/button&gt;
 
 
&lt;!-- Cart offcanvas --&gt;
&lt;div class="offcanvas offcanvas-end" tabindex="-1" id="cartPanel"&gt;
 &lt;div class="offcanvas-header"&gt;
 &lt;h5 class="offcanvas-title"&gt;Shopping Cart
 &lt;button class="btn-close" data-bs-dismiss="offcanvas"&gt;&lt;/button&gt;
 
 &lt;div class="offcanvas-body" id="cartItems"&gt;
 &lt;div class="p-3"&gt;
 &lt;button id="checkoutBtn" class="btn btn-primary w-100"&gt;Checkout&lt;/button&gt;
 

&lt;script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"&gt;&lt;/script&gt;
&lt;script src="js/cart.js"&gt;&lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;
